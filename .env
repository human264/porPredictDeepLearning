# .env  (compose와 같은 폴더)
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypass
POSTGRES_DB=mydb
TZ=Asia/Seoul

# API에서 사용 (FastAPI)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=myuser
DB_PASS=mypass

# 임베딩/튜닝
VEC_DIM=512
ENSEMBLE_ALPHA=0.5     # model vs KNN 가중 (alpha*model + (1-alpha)*knn)
IVFFLAT_PROBES=10      # pgvector 탐색 probe 수

# 학습
BATCH_SIZE=8
ACCUM_STEPS=4
EPOCHS=3
LEARNING_RATE=0.001
MAX_ITEM_LEN=512
MAX_ITEMS_PER_BUNDLE=64

# (Apple Silicon MPS 강제 사용시) 선택
# DEVICE_PREFERENCE=mps
# PYTORCH_ENABLE_MPS_FALLBACK=1
