# DB
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=myuser
DB_PASS=mypass
DB_SCHEMA=public

# 모델/학습
DEVICE_PREFERENCE=auto   # auto|mps|cuda|cpu
CNN_KERNEL_SIZES=2,3,4,5
CNN_EMB_DIM=48
CNN_OUT_CH=64
CNN_DROPOUT=0.1
MAX_ITEM_LEN=4096        # ✅ 핵심
MAX_ITEMS_PER_BUNDLE=64
EPOCHS=3
LEARNING_RATE=0.001
ACCUM_STEPS=4
GLOBAL_SEED=42           # 재현성 필요시
CLIP_NORM=0              # 필요시 1.0 등으로 설정

# 벡터/앙상블
VEC_DIM=512
ENSEMBLE_ALPHA=0.5
IVFFLAT_PROBES=10
FORCE_ENSEMBLE=0

# 룰/앙상블 제어
FORCE_ENSEMBLE=0      # 1이면 규칙 스킵(=바로 앙상블로)
ENSEMBLE_ALPHA=0.5    # 1.0이면 모델 100%(KNN 0%)


# 로깅/옵션
PROPOSED_HISTORY=0
SCORE_DECIMALS=auto
SCORE_MODE=number
SCORE_MAX_DIGITS=15

# 임베딩 규칙 (카테고리 임베딩 차원 자동; 아래 값 지정 시 고정)
CAT_EMB_DIM_DEFAULT=8     # 생략 가능(자동 산정)
MLP_HIDDEN=256
DROPOUT=0.1
