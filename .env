# .env  (compose와 같은 폴더)
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypass
POSTGRES_DB=mydb
TZ=Asia/Seoul

# API에서 사용 (FastAPI)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=myuser
DB_PASS=mypass

# 임베딩/튜닝
VEC_DIM=512
ENSEMBLE_ALPHA=0.5     # model vs KNN 가중 (alpha*model + (1-alpha)*knn)
IVFFLAT_PROBES=10      # pgvector 탐색 probe 수

# 학습
BATCH_SIZE=8
ACCUM_STEPS=4
EPOCHS=3
LEARNING_RATE=0.001
MAX_ITEM_LEN=512
MAX_ITEMS_PER_BUNDLE=64

# (Apple Silicon MPS 강제 사용시) 선택
# DEVICE_PREFERENCE=mps
# PYTORCH_ENABLE_MPS_FALLBACK=1
# 점수 포맷 정책
# SCORE_DECIMALS:
#   - 숫자(n): 소수 n자리 반올림 (예: 6 → 0.932147)
#   - auto   : 반올림 없이 그대로(풀 정밀 float)
SCORE_DECIMALS=auto

# SCORE_MODE:
#   - number : 숫자로 저장/반환 (JSON number)
#   - string : 문자열로 저장/반환 (항상 고정 자릿수 표현이 필요할 때)
SCORE_MODE=number

# (string 모드일 때 최대 유효자리수 제어; 기본 15)
SCORE_MAX_DIGITS=15

FORCE_ENSEMBLE=1