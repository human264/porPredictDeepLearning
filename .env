# 텍스트 인코더: Char-CNN(MPS) | hash(폴백)
TEXT_ENCODER=charcnn
TORCH_DEVICE=auto         # auto|mps|cpu

# Char-CNN
CHARCNN_MAX_LEN=1024
CHARCNN_EMB_DIM=48
CHARCNN_OUT_CH=64
CHARCNN_KERNELS=2,3,4,5
CHARCNN_DROPOUT=0.1
CHARCNN_EPOCHS=2          # 빠르게 피쳐만 학습
CHARCNN_LR=0.001
CHARCNN_BATCH=256

# (폴백용) Hash 경로
XGB_HASH_FEATURES=262144
XGB_CHAR_NGRAM_MIN=3
XGB_CHAR_NGRAM_MAX=5

# XGBoost
XGB_N_ESTIMATORS=600
XGB_LEARNING_RATE=0.07
XGB_MAX_DEPTH=6
XGB_SUBSAMPLE=0.9
XGB_COLSAMPLE_BYTREE=0.9
XGB_TREE_METHOD=hist
XGB_VALID_SPLIT=0.1
XGB_EARLY_STOPPING_ROUNDS=50
